# ============================================================================
# W2W Share - Frontend Production Environment Variables (Vercel)
# ============================================================================

# 1. Full URL to Spring Boot REST API on Render (required in production)
# Example: https://w2w-share-backend.onrender.com/api
VITE_API_URL=https://your-backend-app.onrender.com/api

# 2. Base URL of Spring Boot Backend (used for fallback URL derivation)
# Example: https://w2w-share-backend.onrender.com
VITE_BACKEND_URL=https://your-backend-app.onrender.com

# 3. WebSockets Signaling Server Endpoint on Render (required for WebRTC / chat)
# Note: Use wss:// for secure WebSockets
# Example: wss://w2w-share-backend.onrender.com/ws/signaling
VITE_WS_URL=wss://your-backend-app.onrender.com/ws/signaling

# 4. Optional STUN Servers for Public Internet WebRTC NAT Traversal (comma-separated)
# Defaults to Google's public STUN servers if omitted
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

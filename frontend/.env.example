# =============================================================================
# W2W Share Frontend - Environment Variables Template
# =============================================================================

# Render Backend URL (Example: https://w2w-share-backend.onrender.com)
VITE_API_URL=https://your-backend-app.onrender.com/api
VITE_BACKEND_URL=https://your-backend-app.onrender.com

# WebSocket Signaling URL (Optional - will automatically derive wss:// from VITE_API_URL if omitted)
VITE_WS_URL=wss://your-backend-app.onrender.com/ws/signaling

# Optional Custom STUN / TURN servers (comma-separated, default is Google public STUN)
# VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
